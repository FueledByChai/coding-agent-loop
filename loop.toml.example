# Settings for the ticket loop, read by scripts/loop-config.sh. Copy to .loop.toml at the
# repository root: install.sh does that once and keeps what you then write. This file is the
# kit's and is refreshed by scripts/loop-kit-sync.sh, so read it here and change .loop.toml
# (LK-19). One flat table; strings double-quoted, arrays on one line; a missing key takes its
# default. `scripts/loop-config.sh --all` shows the effective values. TOML is only the config
# format: nothing here depends on the project's language.
[loop]
# The branch pull requests target and done is judged on.
default_branch = "main"
# The ticket file.
backlog = "BACKLOG.md"
# The definition of done, and the cheaper check to run while iterating.
check = "scripts/check.sh"
check_fast = "scripts/check.sh --fast"
# Changes under these paths (a file, a prefix, or a shell pattern) are the kind the checks
# cannot judge: the PR is labelled needs-review and waits for a person instead of auto-merging.
review_paths = []
# Commits must end with a Co-Authored-By trailer naming the agent and model that did the work.
trailer_required = true
# The loop kit: a git URL and a tag, or a directory inside this checkout.
# scripts/loop-kit-sync.sh --check fails when the copied scripts and prompts drift from it.
kit = ""
kit_ref = ""
# The proof gate (scripts/proof-gate.sh): a change under code_paths must come with a change
# under proof_paths, or add a line matching proof_pattern (a test function beside the code),
# or say why in the commit body: `No new test: <reason>`. Empty code_paths: gate off.
# Rust: proof_pattern = "#\\[test\\]"; Java: "@Test"; Python: "def test_".
code_paths = []
proof_paths = []
proof_pattern = ""
# The coverage ratchet (scripts/coverage-ratchet.sh): `coverage` is a command whose output
# ends in one percentage (your tool, wrapped to print the figure); the check fails when it
# is below the number in coverage_floor, and a ticket that raises coverage raises the floor
# in the same commit with `scripts/coverage-ratchet.sh --set`. Empty: ratchet off.
coverage = ""
coverage_floor = "coverage-floor.txt"
# Points of run-to-run jitter the ratchet tolerates (an instrumented suite rarely covers
# exactly the same lines twice): it fails only below floor minus slack, and suggests a raise
# only above floor plus slack.
coverage_slack = "0"
# The agent review (prompts/review-prs.md, scripts/review-status.sh): the commit status it
# posts on each pull request's head; add it to the branch ruleset's required checks so a
# merge waits for the review.
review_context = "Agent review"
# Decision records (scripts/decisions.sh): one file per decision, numbered, never edited in
# place; grill-me reads them before asking and writes one when a story needs a decision.
decisions = "docs/decisions"
# The sprint: the tickets chosen for now, in the order to work them. backlog-status.sh --next
# takes the first ready one of these before falling back to file order; --sprint shows their
# states. Choosing a sprint is a commit that edits this list; a ticket keeps no sprint state.
# This is the subset reading: what is not chosen is the pick list --open prints. A project that
# instead means the sprint to hold every open ticket - so an omission is a fault, not a plan -
# says so in this comment and runs scripts/backlog-status.sh --sprint-check from its check, which
# fails naming an open ticket the list omits (LK-15).
sprint = []
# The product backlog: the stories with their acceptance criteria that tickets say they serve
# ("Serves BT-nnn"). backlog-status.sh --stories derives each story's status from those
# tickets, and --show <id> prints a story or a ticket. "" when the project keeps none.
stories = "docs/PRODUCT_BACKLOG.md"
# A disposable synthetic database for a command that needs one (scripts/with-test-postgres.sh):
# it starts a container, waits for it, runs your command with the URL in its environment, and
# removes the container it created. Nothing here is used until a project names the script from
# its own check; leave the values alone unless the stack needs another image or another URL
# shape, and write the jdbc: form in test_db_url for a JDBC project.
test_db_image = "postgres:17-bookworm"
test_db_name = "test"
test_db_user = "test"
test_db_env = "TEST_DATABASE_URL"
test_db_url = "postgres://{user}:{password}@{host}:{port}/{name}"
